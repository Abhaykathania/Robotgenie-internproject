# Copy to .env and edit. Never commit .env.
PORT=3000
# Serve ../frontend from this server (true) or run the API only (false)
SERVE_FRONTEND=true
# Comma-separated origins allowed to call the API from a browser (needed when the frontend is hosted elsewhere)
ALLOWED_ORIGINS=http://localhost:3000
# Set true when behind a proxy/load balancer (Render, Railway, Nginx) so the real client IP is used for rate limiting
TRUST_PROXY=false
# Max enquiries per IP per window
ENQUIRY_LIMIT=5
ENQUIRY_WINDOW_MINUTES=15
# Bearer token to read GET /api/enquiries. Leave empty to disable that endpoint.
ADMIN_TOKEN=
# Optional: POST each new enquiry as JSON to this URL (Slack/Discord/Zapier/Make/Google Apps Script)
NOTIFY_WEBHOOK_URL=
# Where enquiries are stored (JSON file)
DATA_FILE=./data/enquiries.json
